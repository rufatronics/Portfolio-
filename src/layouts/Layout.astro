---
import '../index.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
}

const {
  title = "Ahmad Garba Adamu — AI Engineer & Researcher",
  description = "Reliable AI systems for low-resource environments. AI engineer and researcher in Kano, Nigeria working on small language models, on-device AI, and Hausa and African-language NLP.",
  image = "https://aga.name.ng/images/ahmad-garba-adamu.jpg",
  canonicalUrl = "https://aga.name.ng/"
} = Astro.props;

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Ahmad Garba Adamu",
  "alternateName": ["Aga", "@rufatronics"],
  "url": "https://aga.name.ng",
  "image": "https://aga.name.ng/images/ahmad-garba-adamu.jpg",
  "jobTitle": "AI Engineer & Researcher",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Kano",
    "addressCountry": "Nigeria"
  },
  "sameAs": [
    "https://github.com/rufatronics",
    "https://huggingface.co/rufatronics",
    "https://linkedin.com/in/ahmad-garba-adamu-91a22631b"
  ],
  "email": "contact@aga.name.ng"
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="Ahmad Garba Adamu" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@rufatronics" />
    <meta name="twitter:creator" content="@rufatronics" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- Theme Initialization Script (Prevents flash of unstyled theme) -->
    <script is:inline>
      (function() {
        const savedTheme = localStorage.getItem('theme');
        if (savedTheme === 'light' || savedTheme === 'dark') {
          document.documentElement.classList.add(savedTheme);
        } else if (window.matchMedia('(prefers-color-scheme: light)').matches) {
          document.documentElement.classList.add('light');
        } else {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>

    <!-- Structured Data JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  </head>
  <body class="antialiased min-h-screen">
    <a href="#main-content" class="skip-to-content">
      Skip to content
    </a>
    <slot />
  </body>
</html>
